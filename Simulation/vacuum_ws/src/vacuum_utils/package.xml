<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vacuum_utils</name>
  <version>0.1.0</version>
  <description>
    Reusable utilities for the Swachh Boudhik Yantra project:
    URDF validation, TF tree verification, and experiment metric collection.
  </description>
  <maintainer email="team@swachh-boudhik-yantra.local">Vacuum Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_py</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>xacro</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
