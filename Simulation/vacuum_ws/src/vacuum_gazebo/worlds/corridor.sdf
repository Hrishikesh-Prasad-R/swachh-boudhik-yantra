<?xml version="1.0"?>
<!--
  corridor.sdf  —  Stage 4A: Manual Mapping Environment 3
  ─────────────────────────────────────────────────────────
  A 12m x 2m corridor with doors, notice boards, and fire extinguishers.

  Layout (top view):
    ┌──────────────────────────────────────────────────────────────┐
    │ [Extinguisher]  [Notice Board]  [Bench]  [Notice Board]      │
    │                                                              │
    │         [Door gap]                  [Door gap]              │
    │                                                              │
    │ [Bin]                                            [Bin]      │
    └──────────────────────────────────────────────────────────────┘
    (12m long x 2m wide, robot starts at west end)

  Challenges for SLAM:
    - Narrow corridor (no wide views for loop closure)
    - Repetitive geometry (RTAB-Map must not confuse identical wall sections)
    - Solution: highly distinct landmarks at regular intervals
-->
<sdf version="1.9">
  <world name="corridor_world">

    <!-- ── Core plugins ─────────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"    name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"    name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"    name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.55 0.57 0.6 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ── Corridor lighting (overhead strip lights) ──────────────────────── -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="strip_1" type="point">
      <pose>-4 0 2.5 0 0 0</pose>
      <diffuse>1 0.98 0.93 1</diffuse>
      <attenuation><range>5</range><constant>0.1</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light name="strip_2" type="point">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>1 0.98 0.93 1</diffuse>
      <attenuation><range>5</range><constant>0.1</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light name="strip_3" type="point">
      <pose>4 0 2.5 0 0 0</pose>
      <diffuse>1 0.98 0.93 1</diffuse>
      <attenuation><range>5</range><constant>0.1</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <!-- ── Floor ─────────────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Corridor structure ─────────────────────────────────────────────
         Corridor: 12m long (x: -6 to +6), 2m wide (y: -1 to +1), 3m tall
         ─────────────────────────────────────────────────────────────────── -->

    <!-- North wall (y = +1.1) — solid continuous -->
    <model name="wall_north">
      <static>true</static><pose>0 1.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.2 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12.2 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <!-- South wall (y = -1.1) — with two door openings at x=-2 and x=+2 -->
    <!-- South wall west segment -->
    <model name="wall_south_w">
      <static>true</static><pose>-4.5 -1.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Door opening west: x = -3 to -2 (1m gap) — above door frame -->
    <model name="wall_south_door_w_top">
      <static>true</static><pose>-2.5 -1.1 2.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 0.2 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 0.2 0.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <!-- South wall centre segment -->
    <model name="wall_south_c">
      <static>true</static><pose>0 -1.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.8 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.8 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Door opening east: x = +1.5 to +2.5 (1m gap) -->
    <model name="wall_south_door_e_top">
      <static>true</static><pose>2.0 -1.1 2.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 0.2 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 0.2 0.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <!-- South wall east segment -->
    <model name="wall_south_e">
      <static>true</static><pose>4.5 -1.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <!-- End walls (west x=-6, east x=+6) -->
    <model name="wall_west">
      <static>true</static><pose>-6.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 2.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.4 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>6.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 2.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.4 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Landmarks (distinct objects at known positions for loop closure) ─ -->

    <!-- Fire extinguishers (red cylinders, opposite ends of corridor) -->
    <model name="extinguisher_w">
      <static>true</static><pose>-5.5 0.7 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.08</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.08</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.85 0.08 0.08 1</diffuse></material></visual>
      </link>
    </model>
    <model name="extinguisher_e">
      <static>true</static><pose>5.5 0.7 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.08</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.08</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.85 0.08 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Notice boards (blue rectangles on north wall — distinct visual features) -->
    <model name="notice_board_w">
      <static>true</static><pose>-3 1.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.04 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.04 0.6</size></box></geometry>
          <material><ambient>0.1 0.25 0.6 1</ambient><diffuse>0.1 0.25 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="notice_board_e">
      <static>true</static><pose>3 1.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.04 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.04 0.6</size></box></geometry>
          <material><ambient>0.6 0.25 0.1 1</ambient><diffuse>0.6 0.25 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bench (mid-corridor north side — loop closure anchor) -->
    <model name="bench">
      <static>true</static><pose>0 0.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.5 0.4 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.5 0.4 0.5</size></box></geometry>
          <material><ambient>0.55 0.38 0.18 1</ambient><diffuse>0.55 0.38 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bins (near ends of corridor) -->
    <model name="bin_w">
      <static>true</static><pose>-5.5 -0.7 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bin_e">
      <static>true</static><pose>5.5 -0.7 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
