<?xml version="1.0"?>
<!--
  _ros2_control.xacro
  ───────────────────
  ros2_control hardware interface declarations for the vacuum robot.

  This file defines the ros2_control tag that maps URDF joints to
  hardware command/state interfaces. It is completely separate from
  simulation-specific tags (_gazebo.xacro) so that replacing the
  hardware plugin from GazeboSimSystem to the Jetson motor driver
  requires only editing this one file.

  Hardware abstraction layers:
    Simulation: gz_ros2_control/GazeboSimSystem
    Real robot: <custom motor driver plugin> (Stage 10)

  Interfaces declared per drive joint:
    command: velocity  (rad/s) — what the controller writes
    state:   position  (rad)   — wheel encoder reading
    state:   velocity  (rad/s) — wheel speed reading

  The caster wheel joint is fixed → no control interfaces needed.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="VacuumRobotHW" type="system">

    <hardware>
      <!--
        GazeboSimSystem reads/writes Gazebo joint states directly.
        This is the simulation equivalent of a real motor driver.
        For hardware deployment, replace only this plugin name.
      -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ── Left Drive Wheel ──────────────────────────────────────── -->
    <joint name="left_wheel_joint">
      <!--
        velocity command interface: the diff_drive_controller writes
        a target wheel angular velocity (rad/s) here each control cycle.
        Limits match _properties.xacro wheel geometry and real motor limits.
      -->
      <command_interface name="velocity">
        <param name="min">-10.0</param>  <!-- ~0.33 m/s max (10 rad/s × 0.033m) -->
        <param name="max">10.0</param>
      </command_interface>
      <!-- position state: accumulated wheel angle from encoder (rad) -->
      <state_interface name="position"/>
      <!-- velocity state: current wheel angular velocity (rad/s) -->
      <state_interface name="velocity"/>
    </joint>

    <!-- ── Right Drive Wheel ─────────────────────────────────────── -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
