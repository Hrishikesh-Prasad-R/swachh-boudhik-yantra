<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vacuum_exploration</name>
  <version>0.1.0</version>
  <description>
    Stage 4B: Autonomous Frontier Exploration for Swachh Boudhik Yantra.
    Implements wavefront frontier detection, configurable goal selection,
    an FSM-driven exploration manager, RViz visualisation, and research metrics.
  </description>
  <maintainer email="rprasadhrishikesh@gmail.com">Hrishikesh-Prasad-R</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
