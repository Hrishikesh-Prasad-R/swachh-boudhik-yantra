<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vacuum_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch orchestration for the Swachh Boudhik Yantra vacuum robot.
    Combines Gazebo, robot description, bridging, and visualisation into
    single launch entry points.
  </description>
  <maintainer email="team@swachh-boudhik-yantra.local">Vacuum Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>vacuum_description</depend>
  <depend>vacuum_gazebo</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
