<?xml version="1.0"?>
<!--
  office.sdf  —  Stage 4A: Manual Mapping Environment 2
  ───────────────────────────────────────────────────────
  An 8m x 6m open-plan office with workstations, a meeting table,
  filing cabinets, and structural pillars.

  Layout:
    ┌────────────────────────────────────────────────────────┐
    │ [Cabinet]   [Meeting Table (6 chairs)]   [Cabinet]     │
    │                                                        │
    │  [Pillar]                              [Pillar]        │
    │                                                        │
    │ [Desk1+PC]  [Desk2+PC]   [Desk3+PC]   [Desk4+PC]      │
    │                                                        │
    │ [Desk5+PC]  [Desk6+PC]   [Whiteboard]  [Potted plant] │
    └────────────────────────────────────────────────────────┘
    (8m wide x 6m deep, origin at centre)
-->
<sdf version="1.9">
  <world name="office_world">

    <!-- ── Core plugins ─────────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"    name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"    name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"    name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.65 0.68 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ── Lighting ──────────────────────────────────────────────────────── -->
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.2 0.1 -0.95</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="office_light_1" type="point">
      <pose>-2 0 2.7 0 0 0</pose>
      <diffuse>1 0.97 0.92 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.1</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="office_light_2" type="point">
      <pose>2 0 2.7 0 0 0</pose>
      <diffuse>1 0.97 0.92 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.1</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- ── Floor ─────────────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Walls (8m x 6m) ────────────────────────────────────────────────── -->
    <model name="wall_north">
      <static>true</static><pose>0 3.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.4 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -3.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.4 0.2 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>4.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.4 3.0</size></box></geometry>
          <material><ambient>0.90 0.90 0.87 1</ambient><diffuse>0.90 0.90 0.87 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-4.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.4 3.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.4 3.0</size></box></geometry>
          <material><ambient>0.90 0.90 0.87 1</ambient><diffuse>0.90 0.90 0.87 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Structural pillars (good loop closure landmarks) ──────────────── -->
    <model name="pillar_nw">
      <static>true</static><pose>-2.5 1.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_ne">
      <static>true</static><pose>2.5 1.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Meeting table (north side) ────────────────────────────────────── -->
    <model name="meeting_table">
      <static>true</static><pose>0 2.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 1.0 0.75</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.5 1.0 0.75</size></box></geometry>
          <material><ambient>0.85 0.78 0.60 1</ambient><diffuse>0.85 0.78 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <!-- 6 chairs around meeting table -->
    <model name="mchair_1"><static>true</static><pose>-1.1 2.0 0.45 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.42 0.42 0.9</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.42 0.42 0.9</size></box></geometry><material><ambient>0.15 0.35 0.55 1</ambient><diffuse>0.15 0.35 0.55 1</diffuse></material></visual></link></model>
    <model name="mchair_2"><static>true</static><pose>0 2.0 0.45 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.42 0.42 0.9</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.42 0.42 0.9</size></box></geometry><material><ambient>0.15 0.35 0.55 1</ambient><diffuse>0.15 0.35 0.55 1</diffuse></material></visual></link></model>
    <model name="mchair_3"><static>true</static><pose>1.1 2.0 0.45 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.42 0.42 0.9</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.42 0.42 0.9</size></box></geometry><material><ambient>0.15 0.35 0.55 1</ambient><diffuse>0.15 0.35 0.55 1</diffuse></material></visual></link></model>
    <model name="mchair_4"><static>true</static><pose>-1.1 2.9 0.45 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.42 0.42 0.9</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.42 0.42 0.9</size></box></geometry><material><ambient>0.15 0.35 0.55 1</ambient><diffuse>0.15 0.35 0.55 1</diffuse></material></visual></link></model>
    <model name="mchair_5"><static>true</static><pose>0 2.9 0.45 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.42 0.42 0.9</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.42 0.42 0.9</size></box></geometry><material><ambient>0.15 0.35 0.55 1</ambient><diffuse>0.15 0.35 0.55 1</diffuse></material></visual></link></model>
    <model name="mchair_6"><static>true</static><pose>1.1 2.9 0.45 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.42 0.42 0.9</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.42 0.42 0.9</size></box></geometry><material><ambient>0.15 0.35 0.55 1</ambient><diffuse>0.15 0.35 0.55 1</diffuse></material></visual></link></model>

    <!-- ── Workstations (south row) ──────────────────────────────────────── -->
    <model name="desk_1"><static>true</static><pose>-3.0 -1.5 0.375 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.4 0.7 0.75</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.4 0.7 0.75</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>
    <model name="desk_2"><static>true</static><pose>-1.2 -1.5 0.375 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.4 0.7 0.75</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.4 0.7 0.75</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>
    <model name="desk_3"><static>true</static><pose>0.8 -1.5 0.375 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.4 0.7 0.75</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.4 0.7 0.75</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>
    <model name="desk_4"><static>true</static><pose>2.8 -1.5 0.375 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>1.4 0.7 0.75</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.4 0.7 0.75</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>

    <!-- PC monitors on desks (black rectangles — high-contrast visual features) -->
    <model name="monitor_1"><static>true</static><pose>-3.0 -1.82 1.1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.5 0.04 0.35</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.5 0.04 0.35</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>
    <model name="monitor_2"><static>true</static><pose>-1.2 -1.82 1.1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.5 0.04 0.35</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.5 0.04 0.35</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>
    <model name="monitor_3"><static>true</static><pose>0.8 -1.82 1.1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.5 0.04 0.35</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.5 0.04 0.35</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>
    <model name="monitor_4"><static>true</static><pose>2.8 -1.82 1.1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.5 0.04 0.35</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.5 0.04 0.35</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>

    <!-- ── Filing cabinets (distinct vertical elements) ──────────────────── -->
    <model name="cabinet_1">
      <static>true</static><pose>-3.8 2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.6 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.6 1.2</size></box></geometry>
          <material><ambient>0.3 0.45 0.6 1</ambient><diffuse>0.3 0.45 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cabinet_2">
      <static>true</static><pose>3.8 2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.6 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.6 1.2</size></box></geometry>
          <material><ambient>0.3 0.45 0.6 1</ambient><diffuse>0.3 0.45 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Whiteboard (white rectangle on south wall — visual landmark) ─── -->
    <model name="whiteboard">
      <static>true</static><pose>1.8 -3.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.04 0.9</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 0.04 0.9</size></box></geometry>
          <material><ambient>0.97 0.97 0.97 1</ambient><diffuse>0.97 0.97 0.97 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Plant in corner (natural visual element) ────────────────────── -->
    <model name="office_plant">
      <static>true</static><pose>3.7 -2.7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.1 0.55 0.15 1</ambient><diffuse>0.1 0.55 0.15 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
