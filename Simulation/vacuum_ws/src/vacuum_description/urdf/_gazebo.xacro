<?xml version="1.0"?>
<!--
  _gazebo.xacro
  ─────────────
  Gazebo Harmonic (Gz 8) simulation properties and plugins.

  Contents:
    1. Per-link surface friction and contact properties
    2. Per-link visual material overrides (Gazebo renderer)
    3. DiffDrive plugin — differential drive kinematics + odometry
    4. JointStatePublisher plugin — publishes joint positions for TF

  Plugin naming convention (Gz 8 / Gazebo Harmonic):
    filename: "gz-sim-<name>-system"
    name:     "gz::sim::systems::<ClassName>"

  Plugin libs located at:
    /opt/ros/jazzy/opt/gz_sim_vendor/lib/gz-sim-8/plugins/
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════
       1. SURFACE PROPERTIES
       ═══════════════════════════════════════════════════════ -->

  <!-- Chassis — standard friction -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Drive wheels — high friction for grip (no wheel slip) -->
  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>200.0</mu1>
    <mu2>100.0</mu2>
    <kp>1.0e+6</kp>
    <kd>1.0</kd>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>200.0</mu1>
    <mu2>100.0</mu2>
    <kp>1.0e+6</kp>
    <kd>1.0</kd>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Caster wheel — near-zero friction for free rolling -->
  <gazebo reference="caster_wheel_link">
    <material>Gazebo/White</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1.0e+6</kp>
    <kd>1.0</kd>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Mount placeholders — no special physics needed -->
  <gazebo reference="camera_mount_link">
    <material>Gazebo/DarkGrey</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Stage 3: camera_link — D435i body -->
  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="arm_mount_link">
    <material>Gazebo/Yellow</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="vacuum_mount_link">
    <material>Gazebo/Blue</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════
       3. gz_ros2_control PLUGIN (Stage 2 — unchanged)
       ═══════════════════════════════════════════════════════ -->
  <!--
    Stage 2 replaces the gz DiffDrive + JointStatePublisher plugins
    with gz_ros2_control. This single plugin bridges Gazebo joint
    physics to the ros2_control hardware interface declared in
    _ros2_control.xacro.

    ros2_control then runs:
      - diff_drive_controller  -> publishes /odom, /tf, subscribes /cmd_vel
      - joint_state_broadcaster -> publishes /joint_states

    All topics are native ROS2 — no ros_gz_bridge needed for them.
    Only /clock and camera topics still require bridging.

    Hardware transition (Jetson):
      Replace 'gz_ros2_control/GazeboSimSystem' in _ros2_control.xacro only.
      This plugin in _gazebo.xacro is removed on hardware entirely.

    Prerequisites:
      sudo apt-get install -y ros-jazzy-gz-ros2-control
  -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!--
        Point to the controllers YAML. controller_manager reads this file
        to know which controllers to load and their parameters.
      -->
      <parameters>$(find vacuum_controller)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════
       4. INTEL REALSENSE D435i — RGB-D CAMERA SENSOR (Stage 3)
       ═══════════════════════════════════════════════════════ -->
  <!--
    Sensor type: rgbd_camera (Gazebo Harmonic gz-sensors 8.x)
    Attached to: camera_link (physical D435i body centre)

    Topic layout generated by rgbd_camera sensor:
      /camera/image_raw               -> colour image  (gz.msgs.Image)
      /camera/image_raw/depth_image   -> depth image   (gz.msgs.Image)
      /camera/image_raw/points        -> point cloud   (gz.msgs.PointCloudPacked)
      /camera/image_raw/camera_info   -> colour info   (gz.msgs.CameraInfo)

    These are bridged to standard ROS topics in gz_bridge.yaml:
      /camera/color/image_raw
      /camera/depth/image_rect_raw
      /camera/depth/points
      /camera/color/camera_info
      /camera/depth/camera_info

    gz_frame_id sets the frame_id in published image headers.
    The TF tree (built from _sensors.xacro) makes the transforms available.

    Noise modes (switch via camera.yaml noise_mode param — no code change):
      ideal:     no noise (default for initial validation)
      realistic: Gaussian depth + colour noise (for EKF/SLAM testing)

    Prerequisites:
      gz-sensors-rgbd-camera is included with Gazebo Harmonic.
      No extra apt packages needed beyond ros-jazzy-ros-gz-bridge.

    Sim-to-real:
      Remove this gazebo block.
      Launch realsense2_camera driver instead.
      Downstream software unchanged.
  -->
  <gazebo reference="camera_link">
    <sensor name="d435i" type="rgbd_camera">
      <camera>
        <!-- ── Colour channel ── -->
        <horizontal_fov>${d435i_color_hfov}</horizontal_fov>
        <image>
          <width>${d435i_color_width}</width>
          <height>${d435i_color_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${d435i_near_clip}</near>
          <far>${d435i_far_clip}</far>
        </clip>

        <!-- ── Depth channel ── -->
        <depth_camera>
          <output>depths</output>
          <clip>
            <near>${d435i_near_clip}</near>
            <far>${d435i_far_clip}</far>
          </clip>
        </depth_camera>

        <!--
          Ideal noise mode (default):
            mean=0, stddev=0 — perfect depth, perfect colour.
          Realistic noise mode:
            Set mean=0, stddev=0.005 for ~5mm depth error at 1m.
            Controlled via camera.yaml at runtime.
        -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </camera>

      <!-- Update at 30 Hz — matches D435i hardware default -->
      <always_on>1</always_on>
      <update_rate>${d435i_color_fps}</update_rate>
      <visualize>false</visualize>

      <!--
        Gazebo topic root.
        rgbd_camera generates sub-topics:
          /camera/image_raw              -> colour image
          /camera/image_raw/depth_image  -> depth image
          /camera/image_raw/points       -> PointCloud2
          /camera/image_raw/camera_info  -> CameraInfo
      -->
      <topic>camera/image_raw</topic>

      <!--
        gz_frame_id: sets frame_id in published ROS messages.
        Using camera_color_optical_frame so image consumers get
        the correct optical frame immediately.
      -->
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>

